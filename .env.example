# All variables are optional. PaperOS runs with none of them set.

# tldraw SDK license key. Without it the canvas shows the tldraw watermark,
# which is allowed under the tldraw free tier. Get a key at https://tldraw.dev
# and set it here to remove the watermark (no code change needed).
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Only used by the 2025 prototype at /legacy. Without it the legacy
# collaboration client stays disconnected and the canvas still renders.
# Key from https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=
