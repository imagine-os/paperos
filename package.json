{
  "name": "paperos",
  "version": "2.0.0-preview.0",
  "description": "PaperOS: a zoomable canvas that behaves like an OS desktop.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "api:gen": "node --experimental-strip-types scripts/gen-api.mts && prettier --write docs/CANVAS_API.md",
    "mcp": "node tools/paperos-mcp/dist/index.js",
    "mcp:build": "npm --prefix tools/paperos-mcp ci && npm --prefix tools/paperos-mcp run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@liveblocks/client": "^3.24.1",
    "@liveblocks/node": "^3.24.1",
    "@liveblocks/react": "^3.24.1",
    "@liveblocks/react-ui": "^3.24.1",
    "@liveblocks/yjs": "^3.24.1",
    "@tldraw/assets": "3.15.6",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "jszip": "^3.10.2",
    "marked": "^18.0.13",
    "next": "^15.5.25",
    "prettier": "^3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldraw": "3.15.6",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
